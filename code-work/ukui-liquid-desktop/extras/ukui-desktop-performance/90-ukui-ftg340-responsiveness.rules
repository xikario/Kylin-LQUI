# Apply immediately on AC unplug/plug, without a polling daemon.
ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Mains", RUN+="/usr/local/libexec/ukui-ftg340-responsiveness apply"
# A late/hotplugged device may start the unit only while persistently enabled.
# disable --now removes this enable link; a stale /run marker cannot bypass it.
ACTION=="add", SUBSYSTEM=="devfreq", KERNEL=="PHYT0048:00", TEST=="/etc/systemd/system/multi-user.target.wants/ukui-ftg340-responsiveness.service", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ukui-ftg340-responsiveness.service", RUN+="/usr/local/libexec/ukui-ftg340-responsiveness apply"
