#!/bin/bash
# Peony Manager Helper - root 权限辅助脚本

set -euo pipefail

ACTION="${1:-dry-run}"
SOURCE="${2:-}"
ARCH="$(uname -m)"
PLUGIN_DIR="/usr/lib/${ARCH}-linux-gnu/peony-extensions"
TARGET="${PLUGIN_DIR}/libpeony-copy-path.so"
if [[ "$ACTION" == *cli-panel ]]; then
    TARGET="${PLUGIN_DIR}/libpeony-cli-panel.so"
fi

json_ok() {
    printf '{"status":"ok","success":true,"action":"%s","targetPath":"%s","message":"%s"}\n' "$1" "$2" "$3"
}

json_error() {
    printf '{"status":"error","success":false,"action":"%s","error":"%s"}\n' "$1" "$2"
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        json_error "$ACTION" "helper 必须通过 pkexec 以 root 身份运行"
        exit 1
    fi
    # Installation accepts only the immutable payload shipped alongside the
    # system package. Reject user-provided code and input links.
    if [[ "$ACTION" == install-* ]]; then
        local NAME="libpeony-copy-path.so"
        [[ "$ACTION" == install-cli-panel ]] && NAME="libpeony-cli-panel.so"
        local PACKAGED="/usr/share/kylin-lqui/peony-plugins/$NAME"
        if [ -n "$SOURCE" ] && [ "$SOURCE" != "$PACKAGED" ]; then
            json_error "$ACTION" "只允许系统插件包中的文件"
            exit 1
        fi
        SOURCE="$PACKAGED"
        /usr/bin/python3 - "$SOURCE" <<'PY'
import os,stat,sys
from pathlib import Path
source=Path(sys.argv[1]);base=source.parent
for path in [base,*base.parents,*base.rglob('*')]:
    st=path.lstat()
    if stat.S_ISLNK(st.st_mode) or st.st_uid!=0 or st.st_mode & 0o022:
        raise SystemExit('插件包包含非系统所有或可写路径；拒绝安装')
    if not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)):
        raise SystemExit('插件包包含非常规文件；拒绝安装')
PY
    fi
}

validate_source() {
    if [ -z "$SOURCE" ]; then
        json_error "$ACTION" "缺少源插件路径"
        exit 1
    fi
    if [ ! -f "$SOURCE" ]; then
        json_error "$ACTION" "源插件文件不存在: $SOURCE"
        exit 1
    fi
    if [ "$(basename "$SOURCE")" != "libpeony-copy-path.so" ]; then
        json_error "$ACTION" "只允许安装 libpeony-copy-path.so"
        exit 1
    fi
    if command -v file >/dev/null 2>&1; then
        if ! file -b "$SOURCE" | grep -qi "shared object"; then
            json_error "$ACTION" "源文件不是 ELF shared object"
            exit 1
        fi
    fi
}

case "$ACTION" in
    install-cli-panel)
        require_root
        if [ ! -f "$SOURCE" ] || [ "$(basename "$SOURCE")" != "libpeony-cli-panel.so" ]; then
            json_error "$ACTION" "请选择完整构建的 libpeony-cli-panel.so"
            exit 1
        fi
        RUNTIME="$(dirname "$SOURCE")/peony-cli-panel"
        for PART in libpeony-cli-terminal.so libqtermwidget5.so.0 libutf8proc.so.2 peony-cli-session data/kb-layouts/default.keytab; do
            if [ ! -f "$RUNTIME/$PART" ]; then
                json_error "$ACTION" "终端组件不完整"
                exit 1
            fi
        done
        if ! file -b "$SOURCE" | grep -qi 'shared object'; then
            json_error "$ACTION" "无效的终端插件文件"
            exit 1
        fi
        install -d -m 0755 "$PLUGIN_DIR" "$PLUGIN_DIR/peony-cli-panel"
        for PART in libpeony-cli-terminal.so libqtermwidget5.so.0 libutf8proc.so.2 peony-cli-session; do
            install -m 0755 "$RUNTIME/$PART" "$PLUGIN_DIR/peony-cli-panel/$PART.new"
            mv -f "$PLUGIN_DIR/peony-cli-panel/$PART.new" "$PLUGIN_DIR/peony-cli-panel/$PART"
        done
        cp -a "$RUNTIME/data" "$RUNTIME/licenses" "$PLUGIN_DIR/peony-cli-panel/"
        chown -R root:root "$PLUGIN_DIR/peony-cli-panel"
        chmod -R go-w "$PLUGIN_DIR/peony-cli-panel"
        install -o root -g root -m 0644 "$SOURCE" "$TARGET.new"
        mv -f "$TARGET.new" "$TARGET"
        json_ok "$ACTION" "$TARGET" "终端插件已安装，重启文管后生效"
        ;;
    remove-cli-panel)
        require_root
        rm -f "$TARGET"
        # Keep runtime until processes using its session supervisor have exited.
        json_ok "$ACTION" "$TARGET" "终端入口已移除，重启文管后生效"
        ;;
    dry-run)
        json_ok "dry-run" "$TARGET" "helper 就绪"
        ;;
    install-copy-path)
        require_root
        validate_source
        install -d -m 0755 "$PLUGIN_DIR"
        install -o root -g root -m 0644 "$SOURCE" "$TARGET"
        json_ok "install-copy-path" "$TARGET" "复制完整路径插件已安装"
        ;;
    remove-copy-path)
        require_root
        if [ -e "$TARGET" ]; then
            rm -f "$TARGET"
        fi
        json_ok "remove-copy-path" "$TARGET" "复制完整路径插件已移除"
        ;;
    *)
        json_error "$ACTION" "未知动作"
        exit 1
        ;;
esac
